---
import pizza from "../../../assets/pizza.json";
import PlotFigure from "../../../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";
import Layout from "../../../layouts/Layout.astro";

export const prerender = true;

export function getStaticPaths() {
  const categories = [...new Set(pizza.map((item) => item.category))];

  return categories.map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params;
const filteredPizza = pizza.filter((item) => item.category === category);

const plotOptions = {
  grid: true,
  marks: [
    Plot.dot(filteredPizza, {
      x: "price",
      y: "revenue",
      r: "orders",
      fill: "day_of_week",
      fillOpacity: 0.75,
    }),
  ],
  x: {
    label: "Prix (€)",
  },
  y: {
    label: "Revenus (€)",
  },
  color: {
    legend: true,
  },
  title: `Prix et revenus - ${category}`,
};
---
<Layout title={`${category} | Pizzas | Data studio`}>
  <section>
    <div class="mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <a href="/pizza/categories" class="text-sm font-medium text-rose-300 transition hover:text-white">&lt;- Toutes les catégories</a>
        <p class="mt-8 text-sm font-semibold uppercase tracking-[0.2em] text-amber-300">Analyse des pizzas</p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight text-white sm:text-5xl">{category}</h1>
      </div>
      <p class="rounded-lg border border-white/10 bg-slate-900 px-4 py-3 text-sm text-slate-300">{filteredPizza.length} référence(s)</p>
    </div>
    <div class="overflow-x-auto rounded-xl border border-white/10 bg-white p-4 shadow-2xl shadow-rose-950/20 sm:p-6">
      <PlotFigure options={plotOptions} />
    </div>
  </section>
</Layout>
