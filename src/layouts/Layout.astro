---
import "../styles/global.css";
const { title = "Explorateur de données" } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    <header class="border-b border-white/10 bg-slate-950/95">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5" aria-label="Navigation principale">
        <a href="/" class="text-sm font-semibold uppercase tracking-[0.18em] text-cyan-300 transition hover:text-white">
          Data studio
        </a>
        <div class="flex items-center gap-6 text-sm text-slate-300">
          <a href="/" class="transition hover:text-cyan-300">Accueil</a>
          <a href="/cars" class="transition hover:text-cyan-300">Voitures</a>
        </div>
      </nav>
    </header>
    <main class="mx-auto w-full max-w-6xl px-6 py-12 sm:py-16">
      <slot />
    </main>
    <footer class="border-t border-white/10 px-6 py-6 text-center text-xs text-slate-500">
      Visualisation de données automobiles
    </footer>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    min-width: 320px;
  }
</style>