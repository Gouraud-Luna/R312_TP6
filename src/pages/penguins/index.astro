---
import penguins from "../../assets/penguins.json";
import Layout from "../../layouts/Layout.astro";
const speciesCount = new Set(penguins.map((penguin) => penguin.species)).size;
const islandCount = new Set(penguins.map((penguin) => penguin.island)).size;
---
<Layout title="Manchots | Data studio">
  <section>
    <div class="mb-10 max-w-2xl">
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-amber-300">Jeu de données animalier</p>
      <h1 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">Explorer les manchots</h1>
      <p class="mt-4 text-lg leading-8 text-slate-400">Choisis un angle d'exploration pour comparer la masse corporelle et la longueur des nageoires.</p>
    </div>
    <div class="grid gap-5 md:grid-cols-2">
      <a href="/penguins/species" class="group rounded-xl border border-white/10 bg-slate-900 p-6 transition hover:-translate-y-1 hover:border-cyan-300/60 hover:bg-slate-800">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-cyan-300">Mode 01</p>
            <h2 class="mt-3 text-2xl font-semibold text-white">Par espèce</h2>
          </div>
          <span aria-hidden="true" class="text-2xl text-cyan-300 transition group-hover:translate-x-1">-&gt;</span>
        </div>
        <p class="mt-4 text-slate-400">Compare les mesures des {speciesCount} espèces de manchots.</p>
      </a>
      <a href="/penguins/islands" class="group rounded-xl border border-white/10 bg-slate-900 p-6 transition hover:-translate-y-1 hover:border-amber-300/60 hover:bg-slate-800">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-amber-300">Mode 02</p>
            <h2 class="mt-3 text-2xl font-semibold text-white">Par île</h2>
          </div>
          <span aria-hidden="true" class="text-2xl text-amber-300 transition group-hover:translate-x-1">-&gt;</span>
        </div>
        <p class="mt-4 text-slate-400">Observe les différences entre les {islandCount} îles étudiées.</p>
      </a>
    </div>
  </section>
</Layout>
