---
import penguins from "../../../assets/penguins.json";
import PlotFigure from "../../../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";
import Layout from "../../../layouts/Layout.astro";

export const prerender = true;

export function getStaticPaths() {
  const species = [...new Set(penguins.map((penguin) => penguin.species))];

  return species.map((name) => ({
    params: { species: name },
  }));
}

const { species: speciesName } = Astro.params;
const filteredPenguins = penguins.filter(
  (penguin) =>
    penguin.species === speciesName &&
    penguin.body_mass_g !== null &&
    penguin.flipper_length_mm !== null,
);

const plotOptions = {
  grid: true,
  marks: [
    Plot.dot(filteredPenguins, {
      x: "flipper_length_mm",
      y: "body_mass_g",
      fill: "species",
      r: 5,
      fillOpacity: 0.75,
    }),
  ],
  x: {
    label: "Longueur des nageoires (mm)",
  },
  y: {
    label: "Masse corporelle (g)",
  },
  color: {
    legend: true,
  },
  title: `Masse et nageoires - ${speciesName}`,
};
---
<Layout title={`${speciesName} | Manchots | Data studio`}>
  <section>
    <div class="mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <a href="/penguins" class="text-sm font-medium text-amber-300 transition hover:text-white">&lt;- Toutes les espèces</a>
        <p class="mt-8 text-sm font-semibold uppercase tracking-[0.2em] text-cyan-300">Analyse des manchots</p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight text-white sm:text-5xl">{speciesName}</h1>
      </div>
      <p class="rounded-lg border border-white/10 bg-slate-900 px-4 py-3 text-sm text-slate-300">{filteredPenguins.length} individu(s)</p>
    </div>
    <div class="overflow-x-auto rounded-xl border border-white/10 bg-white p-4 shadow-2xl shadow-cyan-950/20 sm:p-6">
      <PlotFigure options={plotOptions} />
    </div>
  </section>
</Layout>
