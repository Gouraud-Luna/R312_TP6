---
import penguins from "../../../assets/penguins.json";
import Layout from "../../../layouts/Layout.astro";
const islands = [...new Set(penguins.map((penguin) => penguin.island))].sort();
---
<Layout title="Îles des manchots | Data studio">
  <section>
    <div class="mb-10 max-w-2xl">
      <a href="/penguins" class="text-sm font-medium text-cyan-300 transition hover:text-white">&lt;- Choisir un mode</a>
      <p class="mb-4 mt-8 text-sm font-semibold uppercase tracking-[0.2em] text-amber-300">Mode îles</p>
      <h1 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">Manchots par île</h1>
      <p class="mt-4 text-lg leading-8 text-slate-400">Choisis une île pour comparer les mesures des manchots qui y vivent.</p>
    </div>
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        islands.map((name) => (
          <li>
            <a href={`/penguins/islands/${name}`} class="group flex items-center justify-between rounded-lg border border-white/10 bg-slate-900 px-5 py-4 transition hover:-translate-y-0.5 hover:border-amber-300/60 hover:bg-slate-800">
              <span class="text-base font-medium text-slate-200">{name}</span>
              <span aria-hidden="true" class="text-amber-300 transition group-hover:translate-x-1">-&gt;</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
