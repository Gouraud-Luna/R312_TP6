---
import pizza from "../../../assets/pizza.json";
import Layout from "../../../layouts/Layout.astro";
const categories = [...new Set(pizza.map((item) => item.category))].sort();
---
<Layout title="Catégories de pizzas | Data studio">
  <section>
    <div class="mb-10 max-w-2xl">
      <a href="/pizza" class="text-sm font-medium text-amber-300 transition hover:text-white">&lt;- Choisir un mode</a>
      <p class="mb-4 mt-8 text-sm font-semibold uppercase tracking-[0.2em] text-rose-300">Mode catégories</p>
      <h1 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">Pizzas par catégorie</h1>
      <p class="mt-4 text-lg leading-8 text-slate-400">Choisis une catégorie pour comparer son prix, ses commandes et ses revenus.</p>
    </div>
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((category) => (
          <li>
            <a href={`/pizza/categories/${category}`} class="group flex items-center justify-between rounded-lg border border-white/10 bg-slate-900 px-5 py-4 transition hover:-translate-y-0.5 hover:border-rose-300/60 hover:bg-slate-800">
              <span class="text-base font-medium text-slate-200">{category}</span>
              <span aria-hidden="true" class="text-rose-300 transition group-hover:translate-x-1">-&gt;</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
