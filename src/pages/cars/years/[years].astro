---
import cars from "../../../assets/cars.json";
import PlotFigure from "../../../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";
import Layout from "../../../layouts/Layout.astro";

export const prerender = true;

export function getStaticPaths() {
    const years = [...new Set(cars.map((car) => car.year))];

    return years.map((year) => ({
        params: { years: year.toString() },
    }));
}

const { years: year } = Astro.params;
// Filtrer les voitures pour l'année spécifiée
const filteredCars = cars.filter((car) => car.year.toString() === year);
// Configuration du graphique
const plotOptions = {
    grid: true,
    marks: [
        Plot.dot(filteredCars, {
            x: "weight (lb)",
            y: "power (hp)",
            fill: "steelblue",
            r: 4,
            fillOpacity: 0.7,
        }),
    ],
    x: {
        label: "Poids (lb)",
    },
    y: {
        label: "Puissance (hp)",
    },
    title: `Relation Puissance vs Poids - Voitures ${year}`,
};
---
<Layout title={`Voitures ${year} | Data studio`}>
    <section>
        <div class="mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
            <div>
                <a href="/cars" class="text-sm font-medium text-cyan-300 transition hover:text-white">&lt;- Toutes les années</a>
                <p class="mt-8 text-sm font-semibold uppercase tracking-[0.2em] text-amber-300">Analyse automobile</p>
                <h1 class="mt-3 text-4xl font-semibold tracking-tight text-white sm:text-5xl">Voitures de {year}</h1>
            </div>
            <p class="rounded-lg border border-white/10 bg-slate-900 px-4 py-3 text-sm text-slate-300">{filteredCars.length} véhicule(s)</p>
        </div>
        <div class="overflow-x-auto rounded-xl border border-white/10 bg-white p-4 shadow-2xl shadow-cyan-950/20 sm:p-6">
            <PlotFigure options={plotOptions} />
        </div>
    </section>
</Layout>