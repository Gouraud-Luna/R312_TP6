---
import cars from "../../assets/cars.json";
import Layout from "../../layouts/Layout.astro";
const years = [...new Set(cars.map((c) => c.year))].sort();
---
<Layout title="Voitures | Data studio">
  <section>
    <div class="mb-10 max-w-2xl">
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-amber-300">Jeu de données automobile</p>
      <h1 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">Voitures par année</h1>
      <p class="mt-4 text-lg leading-8 text-slate-400">Choisis une année pour observer le rapport entre le poids et la puissance des véhicules.</p>
    </div>
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        years.map((y) => (
          <li>
            <a href={`/cars/years/${y}`} class="group flex items-center justify-between rounded-lg border border-white/10 bg-slate-900 px-5 py-4 transition hover:-translate-y-0.5 hover:border-cyan-300/60 hover:bg-slate-800">
              <span class="text-base font-medium text-slate-200">Année {y}</span>
              <span aria-hidden="true" class="text-cyan-300 transition group-hover:translate-x-1">-&gt;</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>